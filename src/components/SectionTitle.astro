---
interface Props {
	eyebrow?: string;
	title: string;
	lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<div class="mb-10 max-w-3xl md:mb-14" data-reveal>
	{
		eyebrow && (
			<p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-accent">{eyebrow}</p>
		)
	}
	<h2 class="font-display text-3xl font-bold leading-tight sm:text-4xl md:text-5xl">{title}</h2>
	{lead && <p class="mt-5 text-lg leading-relaxed text-zinc-400">{lead}</p>}
</div>
