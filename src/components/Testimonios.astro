---
import Section from './Section.astro';
import SectionTitle from './SectionTitle.astro';

// Fotos de stock provisionales (Pexels) — reemplazar por fotos reales de clientes
const testimonials = [
	{
		name: 'Laura Gómez',
		role: 'Alumna · 2024',
		quote:
			'Llegué sin saber nada de pesas y en dos meses ya tenía técnica y seguridad. Jesús corrige cada repetición sin presionarte de más.',
		before: { src: '/testimonios/antes-1.jpg', alt: 'Laura Gómez al empezar el entrenamiento' },
		after: { src: '/testimonios/despues-1.jpg', alt: 'Laura Gómez después de entrenar con técnica' },
	},
	{
		name: 'Andrés Ruiz',
		role: 'Alumno · 2023',
		quote:
			'Cambié físicamente, sí, pero sobre todo aprendí a entrenar. Ahora entro al gimnasio sabiendo exactamente qué hacer.',
		before: { src: '/testimonios/antes-2.jpg', alt: 'Andrés Ruiz al empezar el entrenamiento' },
		after: { src: '/testimonios/despues-2.jpg', alt: 'Andrés Ruiz después de entrenar con constancia' },
	},
	{
		name: 'Camila Torres',
		role: 'Alumna · 2024',
		quote:
			'Nunca fui un número más. Siempre sabe en qué estoy trabajando, qué me falta y qué sigue.',
		before: { src: '/testimonios/antes-3.jpg', alt: 'Camila Torres al empezar el entrenamiento' },
		after: { src: '/testimonios/despues-3.jpg', alt: 'Camila Torres después de entrenar' },
	},
];
---

<Section id="testimonios" class="border-t border-zinc-900">
	<SectionTitle
		eyebrow="Testimonios"
		title="Lo que dicen quienes entrenan conmigo"
		lead="La mejor prueba son las personas que ya empezaron: esto dicen después de entrenar conmigo."
	/>

	<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
		{
			testimonials.map((t) => (
				<article class="rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6" data-reveal>
					<div class="grid grid-cols-2 gap-3">
						<figure class="relative">
							<img
								src={t.before.src}
								alt={t.before.alt}
								width="600"
								height="600"
								loading="lazy"
								class="aspect-square w-full rounded-xl object-cover"
							/>
							<figcaption class="absolute bottom-2 left-2 rounded-full bg-ink/80 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-300">
								Antes
							</figcaption>
						</figure>
						<figure class="relative">
							<img
								src={t.after.src}
								alt={t.after.alt}
								width="600"
								height="600"
								loading="lazy"
								class="aspect-square w-full rounded-xl object-cover"
							/>
							<figcaption class="absolute bottom-2 left-2 rounded-full bg-ink/80 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-zinc-300">
								Después
							</figcaption>
						</figure>
					</div>

					<div class="mt-4 flex items-center gap-1" role="img" aria-label="5 de 5 estrellas">
						{Array.from({ length: 5 }).map(() => (
							<svg
								class="h-4 w-4 text-accent"
								viewBox="0 0 24 24"
								fill="currentColor"
								aria-hidden="true"
							>
								<path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
							</svg>
						))}
					</div>

					<blockquote class="mt-3 text-sm leading-relaxed text-zinc-400">
						“{t.quote}”
					</blockquote>

					<footer class="mt-4">
						<p class="text-sm font-semibold text-zinc-100">{t.name}</p>
						<p class="mt-0.5 text-xs text-zinc-500">{t.role}</p>
					</footer>
				</article>
			))
		}
	</div>
</Section>
