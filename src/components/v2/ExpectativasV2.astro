---
const expectations = [
	{
		title: 'Exigencia con dirección',
		text: 'Se exige con sentido: cada repetición tiene un porqué detrás.',
	},
	{
		title: 'Técnica antes que récords',
		text: 'Primero el movimiento bien hecho; los números vendrán en su momento.',
	},
	{
		title: 'Trato sin distancia',
		text: 'Conversación durante la pausa y concentración cuando suena el temporizador.',
	},
	{
		title: 'Resultados medibles',
		text: 'Objetivos medibles y trabajo constante, sin promesas de resultado inmediato.',
	},
	{
		title: 'Puntualidad y constancia',
		text: 'Sesiones a tiempo y con el plan definido: la constancia es el primer requisito.',
	},
	{
		title: 'Respeto por el tiempo',
		text: 'Sesiones aprovechadas, sin tiempos muertos ni esperas innecesarias.',
	},
];
---

<div
	id="que-esperar"
	class="mt-14 border-t border-zinc-900 pt-12 md:mt-20 md:pt-16"
>
	<p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Qué esperar</p>
	<h3 class="mt-3 font-display text-2xl font-bold leading-tight md:text-3xl">
		Esto implica trabajar conmigo
	</h3>
	<p class="mt-3 max-w-2xl text-base leading-relaxed text-zinc-400">
		El mismo compromiso para quien entrena y para quien contrata: sin promesas imposibles ni
		condiciones ocultas.
	</p>

	<ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
		{
			expectations.map((item) => (
				<li
					class="rounded-2xl border border-zinc-800 bg-zinc-900/50 p-6"
					data-reveal
				>
					<h4 class="font-display text-base font-bold text-zinc-50 md:text-lg">
						{item.title}
					</h4>
					<p class="mt-2 text-sm leading-relaxed text-zinc-400">{item.text}</p>
				</li>
			))
		}
	</ul>
</div>
