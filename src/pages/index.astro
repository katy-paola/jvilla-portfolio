---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import SobreMi from '../components/SobreMi.astro';
import ComoTrabajo from '../components/ComoTrabajo.astro';
import Valores from '../components/Valores.astro';
	import Servicios from '../components/Servicios.astro';
	import Testimonios from '../components/Testimonios.astro';
	import Contacto from '../components/Contacto.astro';
	import Footer from '../components/Footer.astro';
	import BackToTop from '../components/BackToTop.astro';

const title = 'Jesús Villadiego · Entrenador deportivo';
const description =
	'Entrenador deportivo en gimnasio, formado en el SENA. Exigencia, técnica y trato cercano: orientación en el gimnasio y entrenamiento personalizado.';
---

<Layout title={title} description={description}>
	<Nav />
	<main>
		<Hero />
		<Valores />
		<SobreMi />
		<ComoTrabajo />
		<Servicios />
		<Testimonios />
		<Contacto />
	</main>
	<Footer />
	<BackToTop />
</Layout>
